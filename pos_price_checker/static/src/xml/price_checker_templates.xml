<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_price_checker.PriceChecker">
        <div class="pos_price_checker">
            <!-- Camera scanner -->
            <div t-if="state.screen === 'camera'" class="pos_price_checker__scanner">
                <div class="pos_price_checker__camera">
                    <BarcodeVideoScanner
                        t-if="state.screen === 'camera'"
                        facingMode="'environment'"
                        onReady.bind="onScannerReady"
                        onResult.bind="onBarcodeDetected"
                        onError.bind="onScannerError"
                        delayBetweenScan="1200"
                    />
                    <div t-if="!state.scannerReady" class="pos_price_checker__camera-loading">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Starting camera...</span>
                    </div>
                    <div t-else="" class="pos_price_checker__overlay">
                        <span class="pos_price_checker__corner pos_price_checker__corner--tl"/>
                        <span class="pos_price_checker__corner pos_price_checker__corner--tr"/>
                        <span class="pos_price_checker__corner pos_price_checker__corner--bl"/>
                        <span class="pos_price_checker__corner pos_price_checker__corner--br"/>
                        <div class="pos_price_checker__scanline"/>
                    </div>
                </div>
                <div class="d-grid mt-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" t-on-click="stopScanner">
                        <i class="fa fa-stop me-1"></i>Stop camera
                    </button>
                </div>
            </div>

            <!-- Idle / start -->
            <div t-if="state.screen === 'idle'" class="text-center">
                <div t-if="!state.scannerSupported" class="alert alert-warning mb-3" role="alert">
                    Your device camera could not be found or is not supported.
                    Please enter the barcode manually below.
                </div>
                <div t-else="">
                    <div class="pos_price_checker__idle-icon mb-3">
                        <i class="fa fa-camera fa-3x" aria-hidden="true"/>
                    </div>

                    <div class="d-grid">
                        <button type="button" class="btn btn-primary btn-lg rounded-pill" t-on-click="startScanner">
                            <i class="fa fa-camera me-2" aria-hidden="true"></i>Start camera
                        </button>
                    </div>
                </div>
            </div>

            <!-- Manual barcode entry -->
            <form class="pos_price_checker__manual mt-4" t-on-submit.prevent="onManualSubmit">
                <div class="pos_price_checker__divider mb-3">
                    <span>or type the barcode</span>
                </div>
                <div class="input-group input-group-lg">
                    <input
                        type="text"
                        id="pos_price_checker_barcode"
                        class="form-control"
                        placeholder="Product barcode"
                        inputmode="numeric"
                        autocomplete="off"
                        aria-label="Product barcode"
                        t-model="state.manualBarcode"
                    />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa fa-search" aria-hidden="true"></i>
                    </button>
                </div>
            </form>

            <!-- Loading -->
            <div t-if="state.screen === 'loading'" class="text-center py-4">
                <span class="spinner-border text-success me-2" role="status" aria-hidden="true"></span>
                Checking price...
            </div>

            <!-- Error / not found -->
            <div
                t-if="state.screen === 'not_found' or state.screen === 'error'"
                class="alert alert-danger mt-4 mb-0 rounded-4" role="alert"
            >
                <div class="d-flex align-items-start">
                    <i class="fa fa-circle-exclamation mt-1 me-2" aria-hidden="true"/>
                    <div class="w-100">
                        <p class="mb-2" t-esc="state.message"/>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" t-on-click="scanAnother">
                            Try again
                        </button>
                    </div>
                </div>
            </div>

            <!-- Result -->
            <div t-if="state.screen === 'success' and state.product" class="mt-3">
                <div class="pos_price_checker__result">
                    <div class="text-center mb-3">
                        <div class="pos_price_checker__image-wrap mx-auto mb-2">
                            <img
                                t-if="state.product.image_src"
                                t-att-src="state.product.image_src"
                                alt="Product"
                                class="pos_price_checker__image"
                            />
                            <i t-else="" class="fa fa-cube pos_price_checker__placeholder" aria-hidden="true"/>
                        </div>
                        <h3 class="h5 mb-1" t-esc="state.product.name"/>
                        <div t-if="state.product.barcode" class="pos_price_checker__barcode">
                            <i class="fa fa-barcode me-1" aria-hidden="true"></i><t t-esc="state.product.barcode"/>
                        </div>
                    </div>

                    <div class="pos_price_checker__price-box text-center">
                        <div class="pos_price_checker__price" t-esc="state.product.price_formatted"/>
                        <div class="pos_price_checker__tax-note">
                            <t t-if="state.product.tax_included">including taxes</t>
                            <t t-else="">excluding taxes</t>
                        </div>
                    </div>

                    <div
                        t-if="state.product.tax_details.length"
                        class="mt-3 small text-muted"
                    >
                        <div
                            t-foreach="state.product.tax_details"
                            t-as="tax" t-key="tax_index"
                            class="d-flex justify-content-between"
                        >
                            <span t-esc="tax.name"/>
                            <span t-esc="tax.amount_formatted"/>
                        </div>
                    </div>

                    <div
                        t-if="state.product.discount > 0"
                        class="mt-2 d-flex justify-content-center align-items-center gap-2"
                    >
                        <s class="text-muted" t-esc="state.product.list_price_formatted"/>
                        <span class="badge bg-success rounded-pill">
                            -<t t-esc="state.product.discount_formatted"/>%
                        </span>
                    </div>

                    <div class="mt-3 text-center">
                        <div t-if="state.product.available_in_pos" class="text-success small">
                            <i class="fa fa-circle-check me-1" aria-hidden="true"></i>Available in this store
                        </div>
                        <div t-else="" class="text-muted small">
                            <i class="fa fa-circle-exclamation me-1" aria-hidden="true"></i>
                            This product is not sold at this store
                        </div>
                    </div>

                    <div class="d-grid mt-3">
                        <button type="button" class="btn btn-primary rounded-pill" t-on-click="scanAnother">
                            <i class="fa fa-camera me-2" aria-hidden="true"></i>Scan another product
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
