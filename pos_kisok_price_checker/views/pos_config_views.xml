<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_price_checker_form" model="ir.ui.view">
        <field name="name">pos.config.price.checker.form</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="row mt16 o_settings_container">
                    <setting string="Enable Price Checker"
                             help="Publish a public, mobile-friendly page where customers scan a product barcode to see the price applicable to this store.">
                        <field name="price_checker_active"/>
                    </setting>
                    <setting string="Tax-Included Price"
                             help="Display the price including taxes on the price-checker page. If disabled, the price excluding taxes is displayed.">
                        <field name="price_checker_tax_included"/>
                    </setting>
                    <div class="content-group mt16" invisible="not price_checker_active">
                        <div class="row mb-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="Pricelist" for="price_checker_pricelist_id"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="price_checker_pricelist_id"
                                       options="{'no_create': True}"
                                       placeholder="Use the store default"/>
                                <p class="text-muted small mt-1 mb-0">
                                    Price list used on the price-checker page. If left empty, the
                                    store's default price list is used, or the product's standard
                                    price when the store has none.
                                </p>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-lg-4 o_light_label">
                                <label for="price_checker_background_color"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="price_checker_background_color" widget="color"/>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="URL Slug" for="price_checker_slug"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="price_checker_slug"
                                       placeholder="e.g. store-a"
                                       help="Leave empty to generate it automatically from the store name."/>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="Public URL" for="price_checker_url"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="price_checker_url" readonly="1" class="text-break"/>
                                <p class="text-muted small mt-1 mb-0">
                                    URL customers use to check the price of a product in this store.
                                </p>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-lg-4 o_light_label">
                                <span class="o_form_label">QR Code</span>
                            </div>
                            <div class="col-lg-8">
                                <field name="price_checker_qr_image" widget="image"
                                       class="border rounded" options="{'no_edit': True}"/>
                                <p class="text-muted small mt-1 mb-0">
                                    Print this QR code and display it in the shop so customers
                                    can open the price checker from their phone.
                                </p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4 o_light_label"/>
                            <div class="col-lg-8">
                                <button name="action_open_price_checker" type="object"
                                        string="Open Price Checker Page"
                                        icon="fa-external-link" class="btn-primary"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
